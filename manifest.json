{
  "manifest_version": 3,
  "name": "Wallpaper Customizer",
  "version": "1.0",
  "description": "Customize your Chrome new tab page with beautiful wallpapers",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wallpaper Customizer"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
